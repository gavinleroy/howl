{
  "name": "little-ml",
  "version": "0.1.0",
  "private": true,
  "description": "React host for the little ML playground",
  "scripts": {
    "build:app": "esbuild web/src/mount.jsx --bundle --splitting --format=esm --jsx=automatic --entry-names=app --outdir=build --minify",
    "build:lib": "esbuild web/src/index.jsx --bundle --splitting --format=esm --jsx=automatic --outdir=dist --external:react --external:react-dom --minify"
  },
  "dependencies": {
    "@codemirror/commands": "6.5.0",
    "@codemirror/language": "6.10.1",
    "@codemirror/legacy-modes": "6.4.0",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3",
    "spytial-core": "^6.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
